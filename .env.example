# AnimeWorld Indexer - Environment Variables
# Copy this file to .env and adjust.

# API key Prowlarr must send (choose a strong one). Empty disables the check.
API_KEY=change-me

# Listen address. 9696 is Prowlarr and 9697 is mircrewrr, so this uses 9698.
PROXY_HOST=0.0.0.0
PROXY_PORT=9698

# SQLite cache lives here (mount a volume).
DATA_DIR=/app/data

# Where the emulated qBittorrent client saves episodes: <DOWNLOAD_DIR>/<category>/.
# Mount the same folder in Sonarr/Radarr at the same path.
DOWNLOAD_DIR=/downloads

# Episodes downloaded at once; the rest wait as "queued" in Sonarr/Radarr.
MAX_DOWNLOADS=2

# AnimeWorld base URL (the .tv and .so domains redirect to .ac).
ANIMEWORLD_URL=https://www.animeworld.ac

# Byparr/FlareSolverr URL, called only when Cloudflare challenges a request.
FLARESOLVERR_URL=http://byparr:8191

# TVDB mapping list (Fribb/anime-lists) and how often it is downloaded again:
MAPPING_URL=https://raw.githubusercontent.com/Fribb/anime-lists/master/anime-list-full.json
MAPPING_REFRESH=24h

# Log level (DEBUG, INFO, WARNING, ERROR). Logs are JSON on stdout.
LOG_LEVEL=INFO

# Politeness knobs (defaults shown).
# Series pages expanded per search:
MAX_SERIES=8
# Simultaneous requests to AnimeWorld:
CONCURRENCY=4
# How long a search waits for file sizes before estimating the rest:
SEARCH_BUDGET=40s
